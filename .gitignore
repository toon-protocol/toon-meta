.DS_Store

# Node — the docs factory adds a root package.json (doc-lint + sandcastle deps).
node_modules/

# Sandcastle runtime artifacts (the committed config lives in .sandcastle/).
.sandcastle/.env
.sandcastle/logs/
.sandcastle/worktrees/

# Prototype build output and runtime state. prototypes/ is 4.1 GB on disk,
# almost all of it node_modules and a Rust target dir, and its state/ holds a
# real BIP-39 mnemonic — none of which may reach this PUBLIC repo.
prototypes/**/node_modules/
prototypes/**/target/
prototypes/*/state/
prototypes/**/*.log

# Tool-output scratch. Playwright-MCP regenerates .playwright-mcp/ every session,
# and the repo has never tracked an image — a figure that belongs here goes in
# docs/assets/ deliberately, so negate it there rather than committing loose PNGs.
.playwright-mcp/
*.png
!docs/assets/*.png
figs.txt

# Python bytecode from the skill-eval-framework scripts.
__pycache__/
*.pyc
